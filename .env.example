# Copy this file to .env.local and fill in the values.
#
# Database — Neon (Postgres)
# Create a free project at https://neon.tech, then copy both connection
# strings from the Neon dashboard (Connection Details):
#   - DATABASE_URL: pooled connection (used by the app at runtime)
#   - DATABASE_URL_UNPOOLED: direct connection (used by drizzle-kit to run migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# OpenAI — used for the LLM classification engine (src/lib/llm.ts)
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# TypeSafe AI (Jev) — used for the Jev classification engine (src/lib/jev.ts)
# Get a key from your TypeSafe AI account
TYPESAFE_API_KEY=
